generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CITIZEN
  COMMUNITY_GROUP
  PRI
  ULB
  GOVERNMENT_DEPARTMENT
  GOVERNMENT_OFFICER
  UNIVERSITY_ADMIN
  FACULTY
  STUDENT
  RESEARCH_ASSISTANT
  INDUSTRY_PARTNER
  STARTUP
  MSME
  CSR_ORGANIZATION
  SYSTEM_ADMIN
}

enum ChallengeStatus {
  DRAFT
  SUBMITTED
  UNDER_GOV_REVIEW
  NEEDS_MORE_INFO
  APPROVED
  REJECTED
  ASSIGNED_TO_UNIVERSITY
  IN_RESEARCH
  SOLUTION_PROPOSED
  IN_PILOT
  DEPLOYED
  RESOLVED
  MERGED_INTO_SYSTEMIC
  CLOSED
}

enum OrganizationType {
  UNIVERSITY
  GOVERNMENT
  INDUSTRY
  STARTUP
  MSME
  CSR
  RESEARCH_INSTITUTION
  COMMUNITY_GROUP
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
  INFORMATION_REQUESTED
}

enum AIAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  UNAVAILABLE
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SeverityLevel {
  LOW
  MODERATE
  SEVERE
  CATASTROPHIC
}

enum RelationshipType {
  DUPLICATE
  RELATED
  SYSTEMIC_CHILD
  SAME_ROOT_CAUSE
  SYSTEMIC_ROOT_CAUSE
  RECURRING
  DEPENDENCY
  INDEPENDENT
}

enum RelationshipStatus {
  DETECTED
  RECOMMENDED
  AI_RECOMMENDED
  PENDING_REVIEW
  APPROVED
  REJECTED
  MERGED
  REQUIRES_EXPERT_REVIEW
  REVERSED
  EXPIRED
}


enum ProjectStatus {
  ASSIGNED
  ACCEPTED
  RESEARCH
  PROPOSAL
  APPROVED
  PROTOTYPE
  TESTING
  PILOT
  DEPLOYMENT
  COMPLETED
  ON_HOLD
  CANCELLED
  FAILED
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_GOV_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  OVERDUE
}

enum DeliverableStatus {
  SUBMITTED
  APPROVED
  REVISION_NEEDED
}

enum PartnershipType {
  MENTORSHIP
  TECHNICAL_SUPPORT
  FUNDING
  PROTOTYPE_SUPPORT
  TESTING
  PILOT
  CSR
  TECH_TRANSFER
}

enum PartnershipStatus {
  PROPOSED
  UNDER_NEGOTIATION
  CONFIRMED
  DECLINED
}

enum TestStatus {
  PLANNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  PASSED
  FAILED
}

enum PilotStatus {
  PLANNING
  APPROVED
  ACTIVE
  IN_PROGRESS
  PAUSED
  COMPLETED
  COMPLETED_WITH_ISSUES
  IMPROVEMENT_REQUIRED
  REVISED_PILOT
  FAILED
}

enum OutcomeType {
  SOCIAL_IMPACT
  PROTOTYPE
  PATENT_FILED
  PATENT_GRANTED
  RESEARCH_PAPER
  RESEARCH_PUBLICATION
  STARTUP
  STARTUP_CREATED
  TECH_TRANSFER
  TECHNOLOGY_TRANSFER
  POLICY_CHANGE
  POLICY_ADOPTION
  DEPLOYED_SOLUTION
  COMMERCIALIZATION
  NO_INNOVATION_OUTCOME
}

enum PrototypeStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
}

enum TestCaseStatus {
  NOT_RUN
  PASSED
  FAILED
  BLOCKED
  WAIVED
}

enum DeploymentStatus {
  PLANNED
  READY_FOR_DEPLOYMENT
  IN_PROGRESS
  DEPLOYED
  OPERATIONAL
  BLOCKED
  FAILED
  ROLLED_BACK
}

enum OutcomeVerificationStatus {
  PENDING
  EVIDENCE_COLLECTION
  UNDER_REVIEW
  VERIFIED
  VERIFIED_WITH_LIMITATIONS
  NOT_VERIFIED
  FOLLOW_UP_REQUIRED
}

enum MemoryOutcomeStatus {
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
  REQUIRES_REVIEW
  SUCCESSFUL
  PARTIALLY_EFFECTIVE
  UNDER_EVALUATION
  INSUFFICIENT_EVIDENCE
  EFFECTIVE
  INEFFECTIVE
  INCONCLUSIVE
}

enum SolutionMemoryStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  REQUIRES_REVIEW
  ARCHIVED
  INSUFFICIENT_EVIDENCE
}

enum ReusabilityClass {
  HIGHLY_REUSABLE
  CONDITIONALLY_REUSABLE
  REQUIRES_ADAPTATION
  NOT_RECOMMENDED
  INSUFFICIENT_EVIDENCE
}

enum EvidenceLevel {
  VERIFIED
  MULTI_SOURCE_VERIFIED
  OFFICIAL
  CITIZEN_REPORTED
  CALCULATED
  ESTIMATED
  AI_ASSISTED
  UNKNOWN
}

enum EmbeddingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRY_REQUIRED
}

enum TeamRole {
  LEAD_FACULTY
  CO_FACULTY
  STUDENT_RESEARCHER
  INDUSTRY_MENTOR
  SUBJECT_EXPERT
}

enum MatchStatus {
  RECOMMENDED
  OFFERED
  ACCEPTED
  REJECTED
}

enum InvitationStatus {
  INVITED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum FundingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REVISION_REQUESTED
  REJECTED
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskProbability {
  LOW
  MEDIUM
  HIGH
}

enum EvidenceEpistemicClass {
  OBSERVED
  COMPUTED
  SOURCE_DERIVED
  INFERRED
  AI_INTERPRETED
  HYPOTHESIZED
  HUMAN_VALIDATED
  VERIFIED_OUTCOME
}

enum InfrastructureImpactStatus {
  OBSERVED_AFFECTED
  POTENTIALLY_AFFECTED
  OBSERVED_NORMAL
  UNKNOWN
  ROOT_CAUSE_CANDIDATE
  MONITORING
}

enum SystemicIncidentStatus {
  DETECTED
  INVESTIGATING
  FIELD_DISPATCHED
  HUMAN_VALIDATED
  INTERVENTION_ACTIVE
  OUTCOME_PENDING
  VERIFIED_RESOLVED
  CLOSED
}

enum InfrastructureNodeType {
  TREATMENT_PLANT
  RESERVOIR
  PUMP_HOUSE
  FEEDER_MAIN
  TRUNK_LINE
  DISTRIBUTION_LINE
  VALVE
  SUBSTATION
  TRANSFORMER
  DRAINAGE_CHANNEL
  SERVICE_AREA
}

enum InfrastructureProvenance {
  GIS_IMPORT
  UTILITY_MAP
  MUNICIPAL_SCHEMATIC
  FIELD_VERIFIED
  INFERRED
  CONTROLLED_DEMO
}

enum InfrastructureEdgeType {
  FLOW_SUPPLY
  FEEDER_BRANCH
  GRAVITY_MAIN
  RETURN_LOOP
  BYPASS
  DEPENDENCY
}

enum HypothesisStatus {
  UNDER_EVALUATION
  LEADING_HYPOTHESIS
  REFUTED
  HUMAN_VALIDATED
  INCONCLUSIVE
}

enum SentinelProbeStatus {
  DRAFT
  DISPATCHED
  ACTIVE
  CONCLUDED
  CANCELLED
}

enum SentinelChoice {
  NORMAL_SERVICE
  DEGRADED_PRESSURE
  CONTAMINATION_ODOR
  NO_SERVICE
  UNSURE
  OTHER
}

enum BranchDifferentialStatus {
  CONFIRMED_AFFECTED
  BRANCH_UNAFFECTED_DISPROVED_UPSTREAM
  INCONCLUSIVE
  INSUFFICIENT_EVIDENCE
}

enum RiskStatus {
  IDENTIFIED
  MITIGATING
  RESOLVED
  ESCALATED
}

model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  passwordHash         String
  fullName             String
  phone                String?
  role                 UserRole               @default(CITIZEN)
  organizationId       String?
  organization         Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  isActive             Boolean                @default(true)
  emailVerified        Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?

  refreshSessions      RefreshSession[]
  challenges           Challenge[]
  timelines            ChallengeTimeline[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  orgMemberships       OrganizationMember[]
  uploadedEvidence     ChallengeEvidence[]
  votes                CommunityVote[]
  teamsLed             MultidisciplinaryTeam[] @relation("LeadFaculty")
  teamMemberships       TeamMember[]
  citizenVerifications CitizenVerification[]
  testExecutions       ProjectTestExecution[]
  facultyProfile       FacultyProfile?
  authoredProposals    ProjectProposal[]       @relation("ProposalAuthor")
  conductedReviews     ProposalReview[]        @relation("Reviewer")
  prototypesCreated    ProjectPrototype[]      @relation("PrototypeAuthor")
  prototypesReviewed   ProjectPrototype[]      @relation("PrototypeReviewer")
  conductedVerifications ProjectOutcomeVerification[] @relation("OutcomeReviewer")
  deployedProjects     ProjectDeployment[]     @relation("ProjectDeployer")
  testCasesTested      ProjectTestCase[]       @relation("TestCaseTester")
  reviewedMemories     SolutionMemory[]        @relation("MemoryReviewer")

  @@index([email])
  @@index([role])
  @@index([organizationId])
}

model RefreshSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model Organization {
  id                  String                     @id @default(uuid())
  name                String
  slug                String                     @unique
  type                OrganizationType
  status              String                     @default("ACTIVE")
  verificationStatus  VerificationStatus         @default(UNVERIFIED)
  verificationDetails Json?
  metadata            Json?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  users               User[]
  members             OrganizationMember[]
  verifications       OrganizationVerification[]
  universityMatches   UniversityMatch[]
  ledProjects         Project[]
  partnerships        IndustryPartnership[]
  industryProfile     IndustryPartnerProfile?

  @@index([slug])
  @@index([verificationStatus])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER")
  joinedAt       DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationVerification {
  id                 String             @id @default(uuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewerId         String?
  status             VerificationStatus
  reviewNotes        String?
  evidenceReferences Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([organizationId])
  @@index([status])
}

model Challenge {
  id                   String                 @id @default(uuid())
  title                String
  description          String
  category             String
  severity             SeverityLevel          @default(MODERATE)
  priority             PriorityLevel          @default(MEDIUM)
  priorityScore        Float                  @default(0)
  status               ChallengeStatus        @default(DRAFT)
  submitterId          String
  submitter            User                   @relation(fields: [submitterId], references: [id], onDelete: Restrict)
  submitterOrgId       String?
  latitude             Float?
  longitude            Float?
  address              String?
  district             String?
  state                String?
  affectedPopulation   Int?
  durationMonths       Int?
  isSystemic           Boolean                @default(false)
  systemicSummary      String?
  isCanonical          Boolean                @default(false)
  canonicalClusterId   String?
  version              Int                    @default(1)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?

  timelines            ChallengeTimeline[]
  aiAnalysis           AIAnalysis?
  evidence             ChallengeEvidence[]
  communityVotes       CommunityVote[]
  sourceRelationships  ChallengeRelationship[] @relation("SourceChallenges")
  targetRelationships  ChallengeRelationship[] @relation("TargetChallenges")
  canonicalClusters    ProblemCluster[]       @relation("CanonicalChallenge")
  clusterMemberships   ProblemClusterMember[]
  sla                  ChallengeSLA?
  impact               ChallengeImpact?
  universityMatches    UniversityMatch[]
  projects             Project[]
  citizenVerifications CitizenVerification[]
  innovationOutcomes   InnovationOutcome[]
  outcomeVerifications ProjectOutcomeVerification[]
  teams                MultidisciplinaryTeam[]
  proposals            ProjectProposal[]
  solutionMemories     SolutionMemory[]
  solutionApplications SolutionMemoryApplication[]
  systemicSignals      SystemicIncidentSignal[]

  @@index([status])
  @@index([submitterId])
  @@index([category])
  @@index([district, state])
  @@index([priorityScore])
}

model ChallengeEvidence {
  id            String    @id @default(uuid())
  challengeId   String
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  fileKey       String
  originalName  String
  mimeType      String
  sizeBytes     Int
  storageBucket String    @default("challenge-evidence")
  uploadedById  String
  uploadedBy    User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())

  @@index([challengeId])
  @@index([uploadedById])
}

model ChallengeTimeline {
  id          String          @id @default(uuid())
  challengeId String
  challenge   Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  fromStatus  ChallengeStatus
  toStatus    ChallengeStatus
  actorId     String
  actor       User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reason      String?
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@index([challengeId])
  @@index([actorId])
}

model CommunityVote {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
}

model ChallengeRelationship {
  id                    String                 @id @default(uuid())
  sourceChallengeId     String
  sourceChallenge       Challenge              @relation("SourceChallenges", fields: [sourceChallengeId], references: [id], onDelete: Cascade)
  targetChallengeId     String
  targetChallenge       Challenge              @relation("TargetChallenges", fields: [targetChallengeId], references: [id], onDelete: Cascade)
  relationType          RelationshipType
  status                RelationshipStatus     @default(RECOMMENDED)
  confidenceScore       Float                  @default(0.0)
  reasoning             String
  approvedById          String?

  problemSimilarity     Float?
  locationSimilarity    Float?
  categoryCompatibility Float?
  infrastructureOverlap Float?
  rootCauseSimilarity   Float?
  evidenceConsistency   Float?
  temporalRelationship  Float?
  factorBreakdown       Json?
  distanceMeters        Float?
  aiExplanation         String?
  sharedInfrastructure  String?
  model                 String?
  modelVersion          String?
  reviewedAt            DateTime?
  reversalReason        String?
  reversedAt            DateTime?
  reversedById          String?

  decisions             ProblemMergeDecision[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([sourceChallengeId])
  @@index([targetChallengeId])
  @@index([relationType])
  @@index([status])
}

model ProblemCluster {
  id                   String                 @id @default(uuid())
  title                String
  description          String?
  category             String
  canonicalChallengeId String?
  canonicalChallenge   Challenge?             @relation("CanonicalChallenge", fields: [canonicalChallengeId], references: [id], onDelete: SetNull)
  rootCauseTitle       String?
  rootCauseSummary     String?
  confidenceScore      Float                  @default(0.0)
  status               RelationshipStatus     @default(PENDING_REVIEW)
  members              ProblemClusterMember[]
  decisions            ProblemMergeDecision[]
  createdById          String?
  reviewedById         String?
  reviewedAt           DateTime?
  reversalReason       String?
  reversedAt           DateTime?
  reversedById         String?
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([canonicalChallengeId])
  @@index([category])
  @@index([status])
}

model ProblemClusterMember {
  id          String         @id @default(uuid())
  clusterId   String
  cluster     ProblemCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  isCanonical Boolean        @default(false)
  joinedAt    DateTime       @default(now())

  @@unique([clusterId, challengeId])
  @@index([clusterId])
  @@index([challengeId])
}

model ProblemMergeDecision {
  id                      String                 @id @default(uuid())
  clusterId               String?
  cluster                 ProblemCluster?        @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  relationshipId          String?
  relationship            ChallengeRelationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  canonicalChallengeId    String
  sourceChallengeIds      String[]
  action                  String
  decisionReason          String
  decidedById             String
  previousPriorityScore   Float?
  newPriorityScore        Float?
  affectedPopulationTotal Int?
  evidenceSnapshot        Json?
  metadata                Json?
  createdAt               DateTime               @default(now())

  @@index([canonicalChallengeId])
  @@index([clusterId])
  @@index([relationshipId])
  @@index([decidedById])
}

model ChallengeSLA {
  id                 String    @id @default(uuid())
  challengeId        String    @unique
  challenge          Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  reviewDeadline     DateTime
  escalationStatus   String    @default("NORMAL")
  escalatedAt        DateTime?
  assignedOfficerId  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([challengeId])
  @@index([escalationStatus])
}

model UniversityMatch {
  id                 String       @id @default(uuid())
  challengeId        String
  challenge          Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  universityOrgId    String
  university         Organization @relation(fields: [universityOrgId], references: [id], onDelete: Cascade)
  matchScore         Float
  matchReasons       Json
  status             MatchStatus  @default(RECOMMENDED)
  rejectionReason    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([challengeId])
  @@index([universityOrgId])
  @@index([status])
}

model MultidisciplinaryTeam {
  id                 String       @id @default(uuid())
  name               String
  challengeId        String?
  challenge          Challenge?   @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  leadFacultyId      String
  leadFaculty        User         @relation("LeadFaculty", fields: [leadFacultyId], references: [id], onDelete: Restrict)
  members            TeamMember[]
  projects           Project[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([leadFacultyId])
  @@index([challengeId])
}

model TeamMember {
  id                 String                @id @default(uuid())
  teamId             String
  team               MultidisciplinaryTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId             String
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInTeam         TeamRole              @default(STUDENT_RESEARCHER)
  invitationStatus   InvitationStatus      @default(ACCEPTED)
  invitedAt          DateTime?
  respondedAt        DateTime?
  declineReason      String?
  joinedAt           DateTime              @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([invitationStatus])
}

model Project {
  id                   String                 @id @default(uuid())
  challengeId          String
  challenge            Challenge              @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  title                String
  description          String
  leadingOrgId         String
  leadingOrg           Organization           @relation(fields: [leadingOrgId], references: [id], onDelete: Restrict)
  teamId               String?
  team                 MultidisciplinaryTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  status               ProjectStatus          @default(ASSIGNED)
  budget               Decimal?               @db.Decimal(14, 2)
  version              Int                    @default(1)
  proposalId           String?
  activatedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  proposals            ProjectProposal[]
  milestones           ProjectMilestone[]
  deliverables         ProjectDeliverable[]
  partnerships         IndustryPartnership[]
  testExecutions       ProjectTestExecution[]
  pilots               ProjectPilot[]
  citizenVerifications CitizenVerification[]
  innovationOutcomes   InnovationOutcome[]
  prototypes           ProjectPrototype[]
  deployments          ProjectDeployment[]
  outcomeVerifications ProjectOutcomeVerification[]
  risks                ProjectRisk[]
  fundingRequests      FundingRequest[]
  solutionMemories     SolutionMemory[]
  solutionApplications SolutionMemoryApplication[]

  @@index([challengeId])
  @@index([leadingOrgId])
  @@index([status])
}

model ProjectProposal {
  id                   String           @id @default(uuid())
  projectId            String
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  challengeId          String?
  challenge            Challenge?       @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  authorId             String?
  author               User?            @relation("ProposalAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  version              Int              @default(1)
  problemUnderstanding String
  rootCauseHypothesis  String
  technicalApproach    String
  budgetBreakdown      Json?
  expectedImpact       String
  risksAndMitigations  String
  sustainabilityPlan   String
  status               ProposalStatus   @default(DRAFT)
  reviewComments       String?
  rejectionReason      String?
  requiredChanges      Json?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  reviews              ProposalReview[]

  @@index([projectId])
  @@index([challengeId])
  @@index([authorId])
  @@index([status])
}

model ProjectMilestone {
  id                   String               @id @default(uuid())
  projectId            String
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                String
  description          String
  orderNumber          Int                  @default(1)
  deadline             DateTime
  budgetAllocated      Decimal?             @db.Decimal(12, 2)
  status               MilestoneStatus      @default(PENDING)
  blockedReason        String?
  dependencyId         String?
  progressPct          Int                  @default(0)
  deliverables         ProjectDeliverable[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([projectId])
  @@index([status])
}

model ProjectDeliverable {
  id                   String            @id @default(uuid())
  milestoneId          String
  milestone            ProjectMilestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  projectId            String
  project              Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                String
  fileKey              String
  version              Int               @default(1)
  status               DeliverableStatus @default(SUBMITTED)
  comments             String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([milestoneId])
  @@index([projectId])
}

model IndustryPartnership {
  id                   String            @id @default(uuid())
  projectId            String
  project              Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partnerOrgId         String
  partnerOrg           Organization      @relation(fields: [partnerOrgId], references: [id], onDelete: Restrict)
  partnershipType      PartnershipType
  fundingOffered       Decimal?          @db.Decimal(14, 2)
  equipmentOffered     String?
  status               PartnershipStatus @default(PROPOSED)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([projectId])
  @@index([partnerOrgId])
}

model ProjectTestExecution {
  id                   String            @id @default(uuid())
  projectId            String
  project              Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testPlan             String
  testCases            Json
  resultsSummary       String
  metrics              Json?
  status               TestStatus        @default(IN_PROGRESS)
  iterationNumber      Int               @default(1)
  conductedById        String
