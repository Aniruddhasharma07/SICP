# ==============================================================================
# SICP ENVIRONMENT CONFIGURATION REFERENCE (.env.example)
# Societal Innovation Collaboration Portal (Phases 1–7 Production Ready)
# ==============================================================================

# --- Node / Backend Environment ---
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL 16 + pgvector) ---
# Docker Compose connection string:
DATABASE_URL=postgresql://user:password@localhost:5432/sicp_db?schema=public

# --- Authentication & Session Security ---
# Secrets must be at least 32 characters long in production
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SECRET=your_cookie_secret_key_minimum_32_chars!

# --- Redis & BullMQ Queue ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Storage & Evidence Buckets ---
SICP_STORAGE_BUCKET=challenge-evidence

# --- AI Service (FastAPI + Gemini / pgvector Semantic Embeddings) ---
AI_SERVICE_URL=http://localhost:8000
EMBEDDING_MODEL=text-embedding-004
# Set your Gemini API Key here for semantic embeddings and problem intelligence.
# If left empty, system honestly marks AI_UNAVAILABLE without hallucinating fake scores.
GEMINI_API_KEY=

# --- Frontend Environment (Next.js 16.3.3 + React 19) ---
NEXT_PUBLIC_API_URL=http://localhost:5000